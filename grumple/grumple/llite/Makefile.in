MODULES := grumple
grumple-objs := dcache.o dir.o file.o llite_lib.o llite_nfs.o
grumple-objs += rw.o lproc_llite.o namei.o symlink.o llite_mmap.o
grumple-objs += xattr.o xattr_cache.o
grumple-objs += rw26.o super25.o statahead.o xattr_security.o
grumple-objs += glimpse.o
grumple-objs += lcommon_cl.o
grumple-objs += lcommon_misc.o
grumple-objs += vvp_dev.o vvp_page.o vvp_io.o vvp_object.o
grumple-objs += pcc.o crypto.o
grumple-objs += llite_foreign.o llite_foreign_symlink.o
grumple-$(CONFIG_FS_POSIX_ACL) += acl.o
grumple-objs += $(grumple-y)
EXTRA_DIST := $(grumple-objs:.o=.c) xattr.c rw26.c super25.c acl.c
EXTRA_DIST += llite_internal.h vvp_internal.h pcc.h
EXTRA_DIST += foreign_symlink.h
@INCLUDE_RULES@
